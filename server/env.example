# Все переменные опциональны — сервер работает и без этого файла.

# Переводит локальный claude CLI (авторизован подпиской, ключи не нужны).
# CLAUDE_BIN=claude              # путь к бинарю, если он не в PATH
# TRANSLATE_CONCURRENCY=5        # параллельных пачек перевода

# Запасной путь загрузки субтитров (/api/fetch)
# YTDLP_PATH=~/Library/Python/3.12/bin/yt-dlp

# PORT=8788
